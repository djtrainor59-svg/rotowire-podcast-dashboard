# Set this in the Vercel project's Environment Variables settings, not in this file.
# Simplecast → Account settings → Private Apps → create a token, then paste it there.
SIMPLECAST_API_TOKEN=

# These are set automatically when you provision a Vercel KV store and connect it
# to this project — you don't need to fill them in yourself.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
